# Example environment variables for SciroccoScrap
# Copy this file to .env and replace placeholders with real values.

# Twilio / WhatsApp (replace placeholders with real values)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
# optional fallback sender variable
WHATSAPP_FROM=whatsapp:+1234567890
WHATSAPP_TO=whatsapp:+19876543210

# SMTP (email) settings — adjust host/port as needed
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=you@example.com
SMTP_TO=notify@example.com

# Notes:
# - Do NOT commit real secrets to the repository.
# - Add .env to .gitignore and store secrets in your CI provider (e.g., GitHub Secrets).